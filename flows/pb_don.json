      }
     ]
    },
    {
     "do": "tap_if",
     "t": [
      "ui/btn_dialog_next",
      "ui/btn_dialog_ok",
      "battle/btn_close_result"
     ]
    },
    {
     "do": "sleep",
     "ms": 1500
    }
   ]
  },
  {
   "do": "tap_if",
   "t": "pb/btn_nhan_thuong"
  },
  {
   "do": "tap_if",
   "t": "pb/btn_roi_pb"
  }
 ]
}